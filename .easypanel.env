# Configurações do EasyPanel
# Copie este arquivo para .easypanel.env.local e preencha com seus valores

# API do EasyPanel
EASYPANEL_API_KEY=your_easypanel_api_key_here
EASYPANEL_SERVER_ID=your_server_id_here
EASYPANEL_PROJECT_NAME=shinobi

# Configurações do Docker Registry
DOCKER_REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-username/shinobi

# Configurações do Banco de Dados
DB_PASSWORD=your_secure_database_password
DB_ROOT_PASSWORD=your_root_password

# Configurações do Shinobi
SUBSCRIPTION_ID=sub_XXXXXXXXXXXX
PLUGIN_KEYS={}
SSL_ENABLED=false

# Domínio personalizado (opcional)
CUSTOM_DOMAIN=your-domain.com

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Configurações de Monitoramento
MONITORING_ENABLED=true
ALERT_EMAIL=your-email@example.com

# Configurações de Recursos
MAX_MEMORY=2G
MAX_CPU=1.0
MIN_MEMORY=512M
MIN_CPU=0.5