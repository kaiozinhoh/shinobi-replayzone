# Configurações padrão para EasyPanel
# Estas variáveis serão automaticamente detectadas pelo EasyPanel

# Configurações da Aplicação
NODE_ENV=production
SHINOBI_PORT=8080

# Configurações do Banco de Dados
DB_HOST=shinobi-db
DB_USER=shinobi
DB_PASSWORD=shinobi123!@#
DB_DATABASE=shinobi
DB_ROOT_PASSWORD=rootpassword123!@#
DB_PORT=3306
DB_TYPE=mysql

# Configurações do Shinobi
SUBSCRIPTION_ID=sub_XXXXXXXXXXXX
PLUGIN_KEYS={}
SSL_ENABLED=false
SSL_COUNTRY=BR
SSL_STATE=SP
SSL_LOCATION=São Paulo
SSL_ORGANIZATION=ReplayZone
SSL_ORGANIZATION_UNIT=IT Department
SSL_COMMON_NAME=shinobi.replayzone.com

# Configurações de Email (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false

# Configurações de Notificação (opcional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configurações de Armazenamento em Nuvem (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Google Drive (opcional)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Configurações de Recursos
MAX_MEMORY=2G
MAX_CPU=1.0
MIN_MEMORY=512M
MIN_CPU=0.5