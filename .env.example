# Configurações do Shinobi
NODE_ENV=production
SHINOBI_PORT=8080

# Configurações do Banco de Dados
DB_HOST=db
DB_USER=shinobi
DB_PASSWORD=your_secure_password_here
DB_DATABASE=shinobi
DB_ROOT_PASSWORD=your_root_password_here

# Configurações do Shinobi
SUBSCRIPTION_ID=sub_XXXXXXXXXXXX
PLUGIN_KEYS={}

# Configurações SSL
SSL_ENABLED=false
SSL_COUNTRY=BR
SSL_STATE=SP
SSL_LOCATION=São Paulo
SSL_ORGANIZATION=Your Organization
SSL_ORGANIZATION_UNIT=IT Department
SSL_COMMON_NAME=your-domain.com

# Docker Registry (para produção)
DOCKER_REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-username/shinobi
IMAGE_TAG=latest

# Configurações de Email (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SECURE=false

# Configurações de Notificação (opcional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configurações de Armazenamento em Nuvem (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Google Drive (opcional)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30