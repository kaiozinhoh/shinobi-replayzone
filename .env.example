#############################
## 🌐 SHINOBI (NVR PRINCIPAL)
#############################

# Ambiente
NODE_ENV=production
SHINOBI_PORT=8080

# Banco de Dados do Shinobi
DB_HOST=db
DB_PORT=3306
DB_USER=shinobi
DB_PASSWORD=your_shinobi_db_password_here
DB_DATABASE=shinobi
DB_ROOT_PASSWORD=your_shinobi_root_password_here
DB_TYPE=mysql

# Configurações do Shinobi
SUBSCRIPTION_ID=sub_XXXXXXXXXXXX
PLUGIN_KEYS={}

# Caminho onde o Shinobi grava os vídeos (dentro do container)
SHINOBI_VIDEOS_PATH=/var/lib/shinobi/videos

# Configurações SSL
SSL_ENABLED=false
SSL_COUNTRY=BR
SSL_STATE=SP
SSL_LOCATION=São Paulo
SSL_ORGANIZATION=Your Organization
SSL_ORGANIZATION_UNIT=IT Department
SSL_COMMON_NAME=your-domain.com

# Docker Registry (para produção)
DOCKER_REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-username/shinobi
IMAGE_TAG=latest

# Configurações de Email (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SECURE=false

# Configurações de Notificação (opcional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configurações de Armazenamento em Nuvem (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# Google Drive (opcional)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30


#############################
## 🎬 REPLAY-SERVER (REPLAYS)
#############################

# Banco de Dados exclusivo do replay
REPLAY_DB_HOST=your_replay_db_host_here
REPLAY_DB_PORT=3306
REPLAY_DB_USER=replay_user
REPLAY_DB_PASSWORD=your_replay_db_password_here
REPLAY_DB_NAME=replayzone
REPLAY_DB_CONNECTION_LIMIT=10

# Servidor do replay
REPLAY_NODE_ENV=production
REPLAY_PORT=3010

# Caminhos usados pelo replay-server
# (devem bater com os volumes montados no Docker/EasyPanel)
FTP_VIDEOS_PATH=/var/www/replay-videos
HLS_PATH=/app/hls
TEMP_PATH=/app/temp

# Tokens do Telegram (opcional)
REPLAY_TELEGRAM_ERROR_TOKEN=
REPLAY_TELEGRAM_SUCCESS_TOKEN=

# URL base pública do replay (opcional)
REPLAY_BASE_URL=https://replay.seu-dominio.com